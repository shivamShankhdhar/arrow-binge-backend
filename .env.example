# Either supply a single DATABASE_URL (auto-parsed) or distinct DB_* properties
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/arrow_binge
DB_USERNAME=arrow_binge
DB_PASSWORD=choose-a-local-password
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_IDS=
SESSION_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_URL=https://api.example.com
PORT=8080
CRON_SECRET=optional-random-cron-secret

